<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-android;net11.0-ios;net10.0-android;net10.0-ios</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">27.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Components.Maui.Resolver</PackageId>
    <Title>Components.Maui.Resolver</Title>
    <Description>Components for MAUI application resolver integration</Description>
    <PackageTags>maui smart ioc di dependencyinjection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Usa.Smart.Core" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Resolver" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MauiComponents\MauiComponents.csproj" />
  </ItemGroup>

</Project>
