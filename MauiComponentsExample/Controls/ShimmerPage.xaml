<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:local="clr-namespace:MauiComponentsExample.Controls"
             xmlns:controls="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="MauiComponentsExample.Controls.ShimmerPage"
             x:DataType="{x:Type local:ShimmerPageViewModel}"
             s:BindingContextResolver.Type="{x:Type local:ShimmerPageViewModel}"
             Title="ShimmerView">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="SkeletonCircle"
                   TargetType="BoxView">
                <Setter Property="WidthRequest" Value="56" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="Color" Value="#E0E0E0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="SkeletonBar"
                   TargetType="BoxView">
                <Setter Property="HeightRequest" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Color" Value="#E0E0E0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="SkeletonShortBar"
                   TargetType="BoxView"
                   BasedOn="{StaticResource SkeletonBar}">
                <Setter Property="Margin" Value="0,0,80,0" />
            </Style>

            <Style x:Key="SkeletonImage"
                   TargetType="BoxView"
                   BasedOn="{StaticResource SkeletonBar}">
                <Setter Property="HeightRequest" Value="140" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="ArticleLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="FontSize" Value="17" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource SampleStack}">

            <Border Style="{StaticResource SampleBorder}">
                <controls:ShimmerView Duration="{Binding Duration}"
                                      Fill="{Binding FillColorIndex, Converter={StaticResource ColorIndexConverter}, ConverterParameter=#F7F2FB}"
                                      IsActive="{Binding IsActive}"
                                      SurfaceColor="{Binding SurfaceColorIndex, Converter={StaticResource ColorIndexConverter}, ConverterParameter=#FFFBFE}"
                                      WaveColor="{Binding WaveColorIndex, Converter={StaticResource ColorIndexConverter}, ConverterParameter=#FFFFFF}"
                                      WaveWidth="{Binding WaveWidth}">
                    <VerticalStackLayout Padding="16"
                                         Spacing="16">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="16">
                            <BoxView Grid.Column="0"
                                     Style="{StaticResource SkeletonCircle}" />
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="10" VerticalOptions="Center">
                                <BoxView Style="{StaticResource SkeletonBar}" />
                                <BoxView Style="{StaticResource SkeletonShortBar}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource SkeletonImage}" />
                        <BoxView Style="{StaticResource SkeletonBar}" />
                        <BoxView Style="{StaticResource SkeletonShortBar}" />
                    </VerticalStackLayout>
                </controls:ShimmerView>
            </Border>

            <Grid Style="{StaticResource OptionGrid}"
                  ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Style="{StaticResource OptionLabel}"
                       Text="IsActive" />
                <Switch Grid.Column="1"
                        IsToggled="{Binding IsActive}" />
            </Grid>

            <VerticalStackLayout Style="{StaticResource OptionStack}">
                <Label Style="{StaticResource OptionLabel}"
                       Text="{Binding WaveWidth, StringFormat='WaveWidth {0:F0}'}" />
                <Slider Value="{Binding WaveWidth}"
                        Minimum="50" Maximum="400" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource OptionStack}">
                <Label Style="{StaticResource OptionLabel}"
                       Text="{Binding Duration, StringFormat='Duration {0:F0}'}" />
                <Slider Value="{Binding Duration}"
                        Minimum="300" Maximum="3000" />
            </VerticalStackLayout>

            <Grid Style="{StaticResource OptionGrid}"
                  ColumnDefinitions="*,*">
                <Label Grid.Column="0"
                       Style="{StaticResource OptionLabel}"
                       Text="Fill" />
                <Picker Grid.Column="1"
                        ItemsSource="{x:Static local:SampleColors.Names}"
                        SelectedIndex="{Binding FillColorIndex}" />
            </Grid>

            <Grid Style="{StaticResource OptionGrid}"
                  ColumnDefinitions="*,*">
                <Label Grid.Column="0"
                       Style="{StaticResource OptionLabel}"
                       Text="WaveColor" />
                <Picker Grid.Column="1"
                        ItemsSource="{x:Static local:SampleColors.Names}"
                        SelectedIndex="{Binding WaveColorIndex}" />
            </Grid>

            <Grid Style="{StaticResource OptionGrid}"
                  ColumnDefinitions="*,*">
                <Label Grid.Column="0"
                       Style="{StaticResource OptionLabel}"
                       Text="SurfaceColor" />
                <Picker Grid.Column="1"
                        ItemsSource="{x:Static local:SampleColors.Names}"
                        SelectedIndex="{Binding SurfaceColorIndex}" />
            </Grid>

            <Button Command="{Binding ReloadCommand}"
                    Text="Reload" />

            <Border Style="{StaticResource SampleBorder}">
                <Grid>
                    <VerticalStackLayout IsVisible="{Binding IsLoaded}"
                                         BindableLayout.ItemsSource="{Binding Articles}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Style="{StaticResource ArticleLabel}"
                                       Text="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <controls:ShimmerView IsVisible="{Binding IsLoading}">
                        <VerticalStackLayout Padding="16"
                                             Spacing="30">
                            <BoxView Style="{StaticResource SkeletonBar}" />
                            <BoxView Style="{StaticResource SkeletonShortBar}" />
                            <BoxView Style="{StaticResource SkeletonBar}" />
                        </VerticalStackLayout>
                    </controls:ShimmerView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
