<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:local="clr-namespace:MauiComponentsExample.Dialogs"
             x:Class="MauiComponentsExample.Dialogs.DialogMenuPage"
             x:DataType="{x:Type local:DialogMenuPageViewModel}"
             s:BindingContextResolver.Type="{x:Type local:DialogMenuPageViewModel}"
             Title="Dialogs">

    <ScrollView>
        <VerticalStackLayout Padding="30,24"
                             Spacing="12">

            <Button Command="{Binding InformationCommand}"
                    Text="Information" />
            <Button Command="{Binding ConfirmCommand}"
                    Text="Confirm" />
            <Button Command="{Binding Confirm3Command}"
                    Text="Confirm3" />
            <Button Command="{Binding SelectCommand}"
                    Text="Select" />
            <Button Command="{Binding InputCommand}"
                    Text="Input" />
            <Button Command="{Binding IndicatorCommand}"
                    Text="Indicator" />
            <Button Command="{Binding LockCommand}"
                    Text="Lock" />
            <Button Command="{Binding LoadingCommand}"
                    Text="Loading" />
            <Button Command="{Binding ProgressCommand}"
                    Text="Progress" />
            <Button Command="{Binding SnackbarCommand}"
                    Text="Snackbar" />
            <Button Command="{Binding ToastCommand}"
                    Text="Toast" />

            <Button Command="{Binding PopupCommand}"
                    Text="Popup" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
