<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:samples="clr-namespace:MauiComponentsExample.Controls">

    <samples:ColorIndexConverter x:Key="ColorIndexConverter" />

    <Style x:Key="SampleStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12,12,12,32" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="OptionStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
    </Style>

    <Style x:Key="OptionGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="ButtonGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="SectionLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="OptionLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="SampleBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="#C8C8C8" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
    </Style>

</ResourceDictionary>
