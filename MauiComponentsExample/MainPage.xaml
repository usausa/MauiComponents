<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:local="clr-namespace:MauiComponentsExample"
             xmlns:controls="clr-namespace:MauiComponentsExample.Controls"
             xmlns:dialogs="clr-namespace:MauiComponentsExample.Dialogs"
             x:Class="MauiComponentsExample.MainPage"
             x:DataType="{x:Type local:MainPageViewModel}"
             s:BindingContextResolver.Type="{x:Type local:MainPageViewModel}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="30,24"
                             Spacing="12" VerticalOptions="Center">

            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type dialogs:DialogMenuPage}"
                    Text="Dialogs" />
            <Button Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type controls:ControlMenuPage}"
                    Text="Controls" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
