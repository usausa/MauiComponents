<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-android;net11.0-ios;net10.0-android;net10.0-ios</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <NoWarn>$(NoWarn);NU5118;NU5129</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">27.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackBuildOutputs</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackBuildOutputs" DependsOnTargets="SatelliteDllsProjectOutputGroup;DebugSymbolsProjectOutputGroup">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\MauiComponents.Generator\bin\$(Configuration)\netstandard2.0\MauiComponents.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <TfmSpecificPackageFile Include="$(PKGSourceGenerateHelper)\lib\netstandard2.0\SourceGenerateHelper.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <TfmSpecificPackageFile Include="..\MauiComponents.props" Pack="true" PackagePath="build\Components.Maui.props" Visible="false" />
      <TfmSpecificPackageFile Include="..\MauiComponents.targets" Pack="true" PackagePath="build\Components.Maui.targets" Visible="false" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <PackageId>Components.Maui</PackageId>
    <Title>MAUI component library</Title>
    <Description>Components for MAUI application</Description>
    <PackageTags>maui</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'true'">
    <Compile Update="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android')) == 'false'">
    <Compile Remove="**\*.android.cs" />
    <None Include="**\*.android.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.android',''))</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'true'">
    <Compile Update="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios')) == 'false'">
    <Compile Remove="**\*.ios.cs" />
    <None Include="**\*.ios.cs">
      <DependentUpon>$([System.String]::Copy('%(FileName)%(Extension)').Replace('.ios',''))</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2)) == '11.0'">
    <PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2)) == '10.0'">
    <PackageReference Include="CommunityToolkit.Maui" Version="16.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SourceGenerateHelper" Version="2.0.0" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Usa.Smart.Core" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MauiComponents.Generator\MauiComponents.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
